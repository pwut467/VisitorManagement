<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Visitor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell d-lg-flex">
        <aside class="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark">V</span>
                <span>
                    <strong>Visitor</strong>
                    <div class="small" style="opacity:.7">ระบบลงทะเบียนผู้มาติดต่อ</div>
                </span>
            </a>
            <div class="nav-section">ปฏิบัติการ</div>
            <nav class="nav flex-column">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>แดชบอร์ด</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Security") || User.IsInRole("Reception") || User.IsInRole("Host"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CheckIn" ? "active" : "")" asp-controller="CheckIn" asp-action="Index"><i class="bi bi-person-plus me-2"></i>ลงทะเบียน / Check-in</a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Security") || User.IsInRole("Reception"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CheckOut" ? "active" : "")" asp-controller="CheckOut" asp-action="Index"><i class="bi bi-box-arrow-right me-2"></i>Check-out / สแกนบัตร</a>
                }
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "OnSite" ? "active" : "")" asp-controller="Visits" asp-action="OnSite"><i class="bi bi-people me-2"></i>ผู้ที่อยู่ในพื้นที่</a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Visits" && ViewContext.RouteData.Values["action"]?.ToString() != "OnSite" ? "active" : "")" asp-controller="Visits" asp-action="Index"><i class="bi bi-journal-text me-2"></i>ประวัติการเข้าพบ</a>
            </nav>
            <div class="nav-section">รายงานและความปลอดภัย</div>
            <nav class="nav flex-column">
                @if (User.IsInRole("Admin") || User.IsInRole("Security") || User.IsInRole("Reception"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart me-2"></i>รายงาน</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Blacklist" ? "active" : "")" asp-controller="Blacklist" asp-action="Index"><i class="bi bi-shield-exclamation me-2"></i>บัญชีดำ</a>
                }
                <a class="nav-link" asp-controller="Home" asp-action="Privacy"><i class="bi bi-lock me-2"></i>นโยบาย PDPA</a>
            </nav>
            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section">ตั้งค่า</div>
                <nav class="nav flex-column">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employees" ? "active" : "")" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-badge me-2"></i>พนักงาน (Host)</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MasterData" ? "active" : "")" asp-controller="MasterData" asp-action="Index"><i class="bi bi-sliders me-2"></i>ข้อมูลหลัก</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear me-2"></i>ผู้ใช้ระบบ</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index"><i class="bi bi-building me-2"></i>บริษัท / บัตร</a>
                </nav>
            }
        </aside>
        <div class="main flex-grow-1">
            <div class="topbar d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">@ViewData["Title"]</div>
                    <div class="small text-muted">เวลาท้องถิ่น กรุงเทพฯ</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="small text-muted">@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button class="btn btn-sm btn-outline-secondary">ออกจากระบบ</button>
                    </form>
                </div>
            </div>
            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed top-0 end-0 p-3">
        @if (TempData["Success"] is string success)
        {
            <div class="toast vm-toast vm-toast-success" role="status" aria-live="polite" data-bs-delay="4200">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>@success</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="toast" aria-label="ปิด"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast vm-toast vm-toast-error" role="alert" aria-live="assertive" data-bs-delay="6000">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>@error</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="toast" aria-label="ปิด"></button>
                </div>
            </div>
        }
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
