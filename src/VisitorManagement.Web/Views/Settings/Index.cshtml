@model SettingsViewModel
@{
    ViewData["Title"] = "ตั้งค่าบริษัท / บัตร Visitor";
}
<form method="post" id="settings-form">
    @Html.AntiForgeryToken()
    <div class="row g-3 align-items-start">
        <div class="col-lg-7">
            <div class="card vm-card p-4 h-100">
                <h2 class="h5 mb-3">บริษัท / บัตร</h2>
                <input type="hidden" asp-for="CompanyId" />
                <div class="mb-3">
                    <label class="form-label">บริษัทที่ใช้งานอยู่</label>
                    <div class="d-flex gap-2 flex-wrap">
                        <select class="form-select" style="max-width:360px" id="switch-company">
                            @foreach (var opt in Model.CompanyOptions)
                            {
                                if (opt.Selected)
                                {
                                    <option value="@opt.Value" selected>@opt.Text</option>
                                }
                                else
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-text">ข้อมูลผู้มาติดต่อแยกตามรหัสบริษัท — สลับบริษัทเพื่อดู/บันทึกเฉพาะบริษัทนั้น</div>
                </div>
                <div class="mb-3">
                    <label asp-for="CompanyCode" class="form-label"></label>
                    <input asp-for="CompanyCode" class="form-control text-uppercase" placeholder="เช่น SKNY" />
                    <div class="form-text">ใช้ในเลขบัตร เช่น SKNY-V20260826-0001</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="BadgeFooter" class="form-label"></label>
                    <textarea asp-for="BadgeFooter" class="form-control" rows="3"></textarea>
                </div>
                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DefaultVisitHours" class="form-label"></label>
                        <input asp-for="DefaultVisitHours" class="form-control" type="number" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="OverstayGraceMinutes" class="form-label"></label>
                        <input asp-for="OverstayGraceMinutes" class="form-control" type="number" />
                    </div>
                </div>
                <fieldset class="mb-3">
                    <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.AutoPrintBadge)</legend>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="AutoPrintBadge" value="true" id="print-direct" @(Model.AutoPrintBadge ? "checked" : null) />
                        <label class="form-check-label" for="print-direct">พิมพ์ออกเครื่องพิมพ์เลย</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="AutoPrintBadge" value="false" id="print-preview" @(!Model.AutoPrintBadge ? "checked" : null) />
                        <label class="form-check-label" for="print-preview">แสดงตัวอย่างก่อน (Print Preview)</label>
                    </div>
                </fieldset>
                <button class="btn btn-teal" type="submit">บันทึก</button>
                <hr class="my-4" />
                <h3 class="h6 text-danger">ล้างข้อมูลผู้มาติดต่อ</h3>
                <p class="text-muted small mb-2">ลบประวัติ Visit / Visitor ของบริษัทที่เลือกอยู่เท่านั้น (ไม่ลบพนักงาน บัญชีผู้ใช้ หรือบัญชีดำ)</p>
                <button class="btn btn-outline-danger" type="submit"
                        formaction="@Url.Action("ClearVisitors")" formmethod="post"
                        onclick="return confirm('ยืนยันล้างข้อมูลผู้มาติดต่อของบริษัทนี้ทั้งหมด? การกระทำนี้ย้อนกลับไม่ได้');">
                    ล้างข้อมูลผู้มาติดต่อของบริษัทนี้
                </button>
                <hr class="my-4" />
                <h3 class="h6">เพิ่มบริษัทใหม่</h3>
                <p class="text-muted small mb-2">สร้างรหัสบริษัทแยก สำหรับเก็บข้อมูลผู้มาติดต่อคนละชุด</p>
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">@Html.DisplayNameFor(m => m.NewCompanyCode)</label>
                        <input name="newCompanyCode" class="form-control text-uppercase" placeholder="รหัส เช่น SITE2" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">@Html.DisplayNameFor(m => m.NewCompanyName)</label>
                        <input name="newCompanyName" class="form-control" placeholder="ชื่อบริษัท" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-primary w-100" type="submit"
                                formaction="@Url.Action("CreateCompany")" formmethod="post">
                            เพิ่ม
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card vm-card p-4 h-100">
                <h2 class="h5 mb-2">Cloud SQL Server</h2>
                <p class="text-muted small mb-3">
                    บันทึก Local ก่อน แล้วซิงก์ไป Cloud เมื่อเชื่อมต่อได้
                    ใช้ <strong>SQL Auth</strong> และเปิด TCP พอร์ต <code>1433</code> ฝั่งเซิร์ฟเวอร์
                </p>
                <div class="alert @(Model.CloudOnline ? "alert-success" : "alert-warning") py-2 mb-3">
                    <strong>@Model.CloudStatusLabel</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.CloudStatusDetail))
                    {
                        <div class="small mt-1">@Model.CloudStatusDetail</div>
                    }
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="CloudEnabled" class="form-check-input" />
                    <label asp-for="CloudEnabled" class="form-check-label"></label>
                </div>
                <div class="mb-3">
                    <label asp-for="CloudServer" class="form-label"></label>
                    <input asp-for="CloudServer" class="form-control" placeholder="192.168.11.204" />
                </div>
                <div class="mb-3">
                    <label asp-for="CloudDatabase" class="form-label"></label>
                    <input asp-for="CloudDatabase" class="form-control" placeholder="VisitorManagment" />
                </div>
                <div class="form-check mb-3">
                    <input asp-for="CloudUseWindowsAuth" class="form-check-input" id="cloud-winauth" />
                    <label asp-for="CloudUseWindowsAuth" class="form-check-label"></label>
                    <div class="form-text">เครื่องอื่นใน LAN ส่วนใหญ่ต้องใช้ SQL Auth</div>
                </div>
                <div id="cloud-sqlauth">
                    <div class="mb-3">
                        <label asp-for="CloudUserId" class="form-label"></label>
                        <input asp-for="CloudUserId" class="form-control" autocomplete="username" placeholder="เช่น sa หรือ VisitorApp" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="CloudPassword" class="form-label"></label>
                        <input asp-for="CloudPassword" class="form-control" autocomplete="new-password" placeholder="@(Model.CloudPasswordSet ? "•••••••• (ว่างไว้ถ้าไม่เปลี่ยน)" : "รหัสผ่าน Cloud SQL")" />
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-teal" type="submit">บันทึก</button>
                    <button class="btn btn-outline-primary" type="submit"
                            formaction="@Url.Action("TestCloud")" formmethod="post">
                        ทดสอบการเชื่อมต่อ
                    </button>
                    <button class="btn btn-outline-secondary" type="submit"
                            formaction="@Url.Action("SyncPending")" formmethod="post">
                        ซิงก์ข้อมูลค้าง
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
<form id="switch-company-form" asp-action="SwitchCompany" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="companyId" id="switch-company-id" />
</form>

@section Scripts {
    <script>
        (function () {
            const win = document.getElementById('cloud-winauth');
            const box = document.getElementById('cloud-sqlauth');
            function sync() {
                if (!win || !box) return;
                box.style.opacity = win.checked ? '0.45' : '1';
                box.querySelectorAll('input').forEach(el => { el.disabled = win.checked; });
            }
            win?.addEventListener('change', sync);
            sync();

            const sel = document.getElementById('switch-company');
            const hidden = document.getElementById('switch-company-id');
            const form = document.getElementById('switch-company-form');
            sel?.addEventListener('change', () => {
                if (!hidden || !form) return;
                hidden.value = sel.value;
                form.requestSubmit();
            });
        })();
    </script>
}
