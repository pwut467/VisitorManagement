@model LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<form asp-action="Login" method="post">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="UserName" class="form-label"></label>
        <input asp-for="UserName" class="form-control" autofocus autocomplete="username" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button class="btn btn-teal w-100">เข้าสู่ระบบ</button>
    @if (ViewBag.CompanyCode is string companyCode && !string.IsNullOrWhiteSpace(companyCode))
    {
        <p class="small text-muted mt-3 mb-1">รหัสบริษัท: @companyCode</p>
    }
    <p class="small text-muted @(ViewBag.CompanyCode is string ? "mb-0" : "mt-3 mb-0")">ตัวอย่าง: 9641 / 123456</p>
</form>
