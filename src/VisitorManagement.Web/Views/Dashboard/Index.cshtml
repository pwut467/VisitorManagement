@model DashboardViewModel
@{
    ViewData["Title"] = "แดชบอร์ด";
    var maxHour = Math.Max(1, Model.Hourly.MaxBy(x => x.Count)?.Count ?? 1);
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="card vm-card stat-card p-3">
            <div class="stat-label">อยู่ในพื้นที่</div>
            <div class="stat-value text-primary">@Model.OnSiteCount</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card vm-card stat-card p-3">
            <div class="stat-label">Check-in วันนี้</div>
            <div class="stat-value">@Model.TodayCheckIns</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card vm-card stat-card p-3">
            <div class="stat-label">Check-out วันนี้</div>
            <div class="stat-value">@Model.TodayCheckOuts</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card vm-card stat-card p-3">
            <div class="stat-label">เกินเวลา / Pre-register</div>
            <div class="stat-value text-danger">@Model.OverstayCount <span class="fs-6 text-muted">/ @Model.PendingPreReg</span></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card vm-card p-3 mb-3">
            <div class="d-flex justify-content-between">
                <h2 class="h6">ผู้ที่อยู่ในพื้นที่</h2>
                <a asp-controller="Visits" asp-action="OnSite">ดูทั้งหมด</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>บัตร</th><th>ผู้มาติดต่อ</th><th>มาหา</th><th>เข้าเมื่อ</th><th></th></tr></thead>
                    <tbody>
                    @if (!Model.OnSite.Any())
                    {
                        <tr><td colspan="5" class="text-muted">ยังไม่มีผู้มาติดต่อในพื้นที่</td></tr>
                    }
                    @foreach (var v in Model.OnSite)
                    {
                        <tr class="@(v.IsOverstay(TimeHelper.Now) ? "overstay" : "")">
                            <td class="fw-semibold">@v.VisitNumber</td>
                            <td>@v.Visitor.FullName<br /><span class="small text-muted">@v.CompanyName</span></td>
                            <td>@v.HostEmployee.FullName</td>
                            <td>@v.CheckInAt?.ToString("HH:mm")</td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-controller="Visits" asp-action="Details" asp-route-id="@v.Id">รายละเอียด</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card vm-card p-3">
            <h2 class="h6">Check-in รายชั่วโมงวันนี้</h2>
            <div class="hour-bar mt-2">
                @foreach (var h in Model.Hourly)
                {
                    var height = (int)Math.Round(100.0 * h.Count / maxHour);
                    <div class="bar" title="@h.Label:00 = @h.Count" style="height:@(Math.Max(6, height))%"></div>
                }
            </div>
            <div class="d-flex justify-content-between small text-muted mt-1">
                @foreach (var h in Model.Hourly)
                {
                    <span>@h.Label</span>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card vm-card p-3 mb-3">
            <h2 class="h6 text-danger">เกินกำหนดออก</h2>
            @if (!Model.Overstay.Any())
            {
                <p class="text-muted mb-0">ไม่มีรายการเกินเวลา</p>
            }
            @foreach (var v in Model.Overstay)
            {
                <div class="d-flex justify-content-between border-bottom py-2">
                    <div>
                        <div class="fw-semibold">@v.Visitor.FullName</div>
                        <div class="small text-muted">ควรออก @v.ExpectedCheckoutAt?.ToString("HH:mm")</div>
                    </div>
                    <a class="btn btn-sm btn-outline-danger" asp-controller="CheckOut" asp-action="Index" asp-route-code="@v.VisitNumber">Check-out</a>
                </div>
            }
        </div>
        <div class="card vm-card p-3">
            <h2 class="h6">ล่าสุด</h2>
            @foreach (var v in Model.Recent)
            {
                <div class="small py-2 border-bottom">
                    <a asp-controller="Visits" asp-action="Details" asp-route-id="@v.Id">@v.VisitNumber</a>
                    · @v.Visitor.FullName
                    <div class="text-muted">@v.Status</div>
                </div>
            }
        </div>
    </div>
</div>
