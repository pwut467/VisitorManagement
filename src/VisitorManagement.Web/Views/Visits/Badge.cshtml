@model Visit
@{
    Layout = null;
    var company = (CompanyProfile)ViewBag.Company;
    var barcode = ViewBag.BarcodeSvg as string ?? "";
    var autoPrint = ViewFlag.IsOn(ViewBag.AutoPrint);
    var returnUrl = ViewBag.ReturnUrl as string;
    var detailsUrl = Url.Action("Details", "Visits", new { id = Model.Id, returnUrl }) ?? $"/Visits/Details/{Model.Id}";
    var checkInAt = Model.CheckInAt ?? Model.CreatedAt;
    var purpose = Model.VisitPurpose.Name;
    if (!string.IsNullOrWhiteSpace(Model.PurposeDetail))
    {
        purpose += " — " + Model.PurposeDetail;
    }
    var companyName = string.IsNullOrWhiteSpace(Model.CompanyName) ? Model.Visitor.CompanyName : Model.CompanyName;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>บัตร Visitor @Model.VisitNumber</title>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        @@page { size: 80mm auto; margin: 0; }
        * { box-sizing: border-box; }
        body {
            font-family: "IBM Plex Sans Thai", sans-serif;
            width: 80mm;
            margin: 0 auto;
            padding: 3mm;
            color: #111;
        }
        .toolbar { text-align: center; margin-bottom: 8px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
        .toolbar a, .toolbar button {
            font-family: inherit;
            font-size: 13px;
            padding: 6px 10px;
            border: 1px solid #1a56a0;
            background: #1a56a0;
            color: #fff;
            border-radius: 4px;
            text-decoration: none;
            cursor: pointer;
        }
        .toolbar a.secondary { background: #fff; color: #1a56a0; }
        .badge {
            border: 2px solid #111;
            padding: 6px 8px 10px;
        }
        .head {
            text-align: center;
            border-bottom: 1px solid #111;
            padding-bottom: 4px;
            margin-bottom: 6px;
        }
        .head .company { font-size: 11px; font-weight: 600; line-height: 1.3; }
        .head .title { font-size: 16px; font-weight: 700; }
        .barcode { text-align: center; margin: 4px 0 8px; width: 100%; }
        /* Do not set a fixed height — stretching Code128 bars makes them unscannable. */
        .barcode svg {
            display: block;
            width: 100%;
            max-width: 74mm;
            height: auto;
            margin: 0 auto;
        }
        .row {
            display: flex;
            gap: 6px;
            font-size: 12px;
            line-height: 1.35;
            margin: 4px 0;
            align-items: flex-end;
        }
        .lbl { flex: 0 0 28mm; font-weight: 600; }
        .val {
            flex: 1;
            border-bottom: 1px dotted #111;
            min-height: 16px;
            padding-bottom: 1px;
        }
        .signs { margin-top: 10px; }
        .sign {
            margin-top: 10px;
            text-align: center;
            font-size: 11px;
        }
        .sign .line {
            border-bottom: 1px solid #111;
            height: 22px;
            margin: 0 8px 3px;
        }
        @@media print {
            .toolbar { display: none; }
            body { width: 80mm; padding: 2mm; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">พิมพ์บัตร / พิมพ์ซ้ำ</button>
        <a class="secondary" href="@detailsUrl">กลับ</a>
        @if (autoPrint)
        {
            <div style="flex-basis:100%;font-size:12px;color:#334155">กำลังส่งไปเครื่องพิมพ์...</div>
        }
        else
        {
            <div style="flex-basis:100%;font-size:12px;color:#334155">ตัวอย่างบัตร — กดพิมพ์เมื่อพร้อม</div>
        }
    </div>
    <div class="badge">
        <div class="head">
            <div class="company">@company.Name</div>
            <div class="title">บัตรผู้มาติดต่อ</div>
        </div>
        <div class="barcode">@Html.Raw(barcode)</div>
        <div class="row"><span class="lbl">เลขที่</span><span class="val">@Model.VisitNumber</span></div>
        <div class="row"><span class="lbl">วันที่เวลาเข้า</span><span class="val">@checkInAt.ToString("dd/MM/yyyy HH:mm")</span></div>
        <div class="row"><span class="lbl">ชื่อผู้มาติดต่อ</span><span class="val">@Model.GuestFullName</span></div>
        <div class="row"><span class="lbl">ทะเบียนรถ</span><span class="val">@(string.IsNullOrWhiteSpace(Model.VehiclePlate) ? " " : Model.VehiclePlate)</span></div>
        <div class="row"><span class="lbl">หน่วยงาน</span><span class="val">@(string.IsNullOrWhiteSpace(companyName) ? " " : companyName)</span></div>
        <div class="row"><span class="lbl">วัตถุประสงค์</span><span class="val">@purpose</span></div>
        <div class="row"><span class="lbl">ผู้ต้องการพบ</span><span class="val">@Model.HostEmployee.FullName</span></div>
        <div class="signs">
            <div class="sign">
                <div class="line"></div>
                <div>ลงชื่อ ผู้รับการติดต่อ</div>
            </div>
            <div class="sign">
                <div class="line"></div>
                <div>ลงชื่อ (เจ้าหน้าที่ ร.ป.ภ.)</div>
            </div>
        </div>
    </div>
    @if (autoPrint)
    {
        <script>
            async function triggerPrint() {
                if (document.fonts && document.fonts.ready) {
                    try { await document.fonts.ready; } catch { }
                }
                window.print();
            }
            if (document.readyState === 'complete') {
                triggerPrint();
            } else {
                window.addEventListener('load', triggerPrint);
            }
        </script>
    }
</body>
</html>
