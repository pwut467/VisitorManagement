@model IEnumerable<BlacklistEntry>
@{
    ViewData["Title"] = "บัญชีดำ";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Security") || User.IsInRole("Reception");
    var isAdmin = User.IsInRole("Admin");
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="d-flex justify-content-between mb-3">
    <p class="text-muted mb-0">บุคคลในบัญชีดำจะถูกปฏิเสธตอน Check-in — ลบได้เฉพาะ Admin</p>
    @if (canManage)
    {
        <a class="btn btn-teal" asp-action="Create">เพิ่มรายชื่อ</a>
    }
</div>
<div class="card vm-card p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>เลขบัตร</th>
                    <th>ชื่อ</th>
                    <th>เหตุผล</th>
                    <th>หมดอายุ</th>
                    <th>สถานะ</th>
                    <th class="text-end">จัดการ</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@await Html.PartialAsync("_NationalIdReveal", x.NationalId)</td>
                    <td>@x.FullName</td>
                    <td>@x.Reason</td>
                    <td>@(x.ExpiresAt?.ToString("dd/MM/yyyy") ?? "ไม่หมดอายุ")</td>
                    <td>@(x.IsActive ? "ใช้งาน" : "ปิด")</td>
                    <td class="text-end text-nowrap">
                        @if (canManage)
                        {
                            <form asp-action="Toggle" asp-route-id="@x.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">สลับสถานะ</button>
                            </form>
                        }
                        @if (isAdmin)
                        {
                            <form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('ลบบัญชีดำ @x.FullName ใช่หรือไม่?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">ลบ</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
