@model EmployeeFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "เพิ่มพนักงาน" : "แก้ไขพนักงาน";
    var action = Model.Id is null ? "Create" : "Edit";
}
<div class="card vm-card p-4" style="max-width:640px">
    <form asp-action="@action" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="EmployeeCode" class="form-label"></label>
            <input asp-for="EmployeeCode" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="DepartmentId" class="form-label"></label>
            <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <button class="btn btn-teal">บันทึก</button>
        <a class="btn btn-outline-secondary" asp-action="Index">ยกเลิก</a>
    </form>
</div>
