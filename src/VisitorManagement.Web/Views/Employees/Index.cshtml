@model IEnumerable<Employee>
@{
    ViewData["Title"] = "พนักงาน (Host)";
}
<div id="employee-alert" class="d-none"></div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<div class="d-flex justify-content-between mb-3">
    <p class="text-muted mb-0">พนักงานที่ผู้มาติดต่อสามารถระบุว่ามาหา — ลบแล้วจะไม่ถูกสร้างกลับอัตโนมัติ</p>
    <a class="btn btn-teal" asp-action="Create">เพิ่มพนักงาน</a>
</div>
<div class="card vm-card p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0" id="employees-table">
            <thead>
                <tr>
                    <th>รหัส</th>
                    <th>ชื่อ</th>
                    <th>แผนก</th>
                    <th>โทร</th>
                    <th>สถานะ</th>
                    <th class="text-end">จัดการ</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr data-employee-id="@e.Id">
                    <td>@e.EmployeeCode</td>
                    <td>@e.FullName</td>
                    <td>@e.Department?.Name</td>
                    <td>@e.Phone</td>
                    <td>@(e.IsActive ? "ใช้งาน" : "ปิด")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">แก้ไข</a>
                        <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline js-delete-employee"
                              data-name="@e.FullName">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">ลบ</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
<script>
(() => {
  const alertBox = document.getElementById("employee-alert");
  function showAlert(type, message) {
    if (!alertBox) return;
    alertBox.className = `alert alert-${type}`;
    alertBox.textContent = message;
    alertBox.classList.remove("d-none");
  }

  document.querySelectorAll("form.js-delete-employee").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const name = form.getAttribute("data-name") || "พนักงาน";
      if (!confirm(`ลบพนักงาน ${name} ใช่หรือไม่?`)) return;

      const row = form.closest("tr");
      const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest",
            "RequestVerificationToken": token || ""
          },
          body: new FormData(form)
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.ok === false) {
          showAlert("danger", data.message || "ลบไม่สำเร็จ");
          return;
        }
        row?.remove();
        showAlert("success", data.message || `ลบพนักงาน ${name} แล้ว`);
      } catch {
        showAlert("danger", "ลบไม่สำเร็จ กรุณาลองใหม่");
      }
    });
  });
})();
</script>
}
