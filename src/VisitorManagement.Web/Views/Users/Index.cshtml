@model List<(ApplicationUser User, IList<string> Roles, bool IsOfficial)>
@{
    ViewData["Title"] = "ผู้ใช้ระบบ";
}
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<div class="d-flex justify-content-between mb-3">
    <p class="text-muted mb-0">สิทธิ์: Admin, Security (รปภ.), Reception, Host</p>
    <a class="btn btn-teal" asp-action="Create">เพิ่มผู้ใช้</a>
</div>
<div class="card vm-card p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>ชื่อ</th>
                    <th>ชื่อผู้ใช้</th>
                    <th>สิทธิ์</th>
                    <th>สถานะ</th>
                    <th class="text-end">จัดการ</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.User.FullName</td>
                    <td>@row.User.UserName</td>
                    <td>@string.Join(", ", row.Roles)</td>
                    <td>@(row.User.IsActive ? "ใช้งาน" : "ปิด")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@row.User.Id">แก้ไข</a>
                        <form asp-action="Toggle" asp-route-id="@row.User.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">สลับสถานะ</button>
                        </form>
                        @if (!row.IsOfficial)
                        {
                            <form asp-action="Delete" asp-route-id="@row.User.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('ลบผู้ใช้ @row.User.UserName ใช่หรือไม่?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">ลบ</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
