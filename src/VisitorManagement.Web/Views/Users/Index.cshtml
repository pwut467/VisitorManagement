@model List<(ApplicationUser User, IList<string> Roles)>
@{
    ViewData["Title"] = "ผู้ใช้ระบบ";
}
<div class="d-flex justify-content-between mb-3">
    <p class="text-muted mb-0">สิทธิ์: Admin, Security (รปภ.), Reception, Host</p>
    <a class="btn btn-teal" asp-action="Create">เพิ่มผู้ใช้</a>
</div>
<div class="card vm-card p-3">
    <table class="table">
        <thead><tr><th>ชื่อ</th><th>ชื่อผู้ใช้</th><th>สิทธิ์</th><th>สถานะ</th><th></th></tr></thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.User.FullName</td>
                <td>@row.User.UserName</td>
                <td>@string.Join(", ", row.Roles)</td>
                <td>@(row.User.IsActive ? "ใช้งาน" : "ปิด")</td>
                <td>
                    <form asp-action="Toggle" asp-route-id="@row.User.Id" method="post">
                        <button class="btn btn-sm btn-outline-secondary">สลับสถานะ</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
