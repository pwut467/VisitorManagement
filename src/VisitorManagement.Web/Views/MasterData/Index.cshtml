@{
    ViewData["Title"] = "ข้อมูลหลัก";
    var departments = (IEnumerable<Department>)ViewBag.Departments;
    var gates = (IEnumerable<Gate>)ViewBag.Gates;
    var types = (IEnumerable<VisitorType>)ViewBag.Types;
    var purposes = (IEnumerable<VisitPurpose>)ViewBag.Purposes;
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card vm-card p-3 mb-3">
            <h2 class="h5">แผนก</h2>
            <form asp-action="AddDepartment" method="post" class="row g-2 mb-3">
                @Html.AntiForgeryToken()
                <div class="col-4"><input name="code" class="form-control" placeholder="รหัส" /></div>
                <div class="col-5"><input name="name" class="form-control" placeholder="ชื่อแผนก" /></div>
                <div class="col-3"><button class="btn btn-teal w-100">เพิ่ม</button></div>
            </form>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                    @foreach (var d in departments)
                    {
                        <tr>
                            <td colspan="4" class="border-0 pb-0">
                                <form asp-action="EditDepartment" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <div class="col-3"><input name="code" class="form-control form-control-sm" value="@d.Code" /></div>
                                    <div class="col-4"><input name="name" class="form-control form-control-sm" value="@d.Name" /></div>
                                    <div class="col-2 small">@(d.IsActive ? "ใช้งาน" : "ปิด")</div>
                                    <div class="col-3 text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-primary" type="submit">บันทึก</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end pt-0">
                                <form asp-action="Toggle" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="department" />
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">สลับสถานะ</button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('ลบแผนก @d.Name ใช่หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="department" />
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">ลบ</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card vm-card p-3">
            <h2 class="h5">จุดเข้า-ออก</h2>
            <form asp-action="AddGate" method="post" class="row g-2 mb-3">
                @Html.AntiForgeryToken()
                <div class="col-5"><input name="name" class="form-control" placeholder="ชื่อประตู" /></div>
                <div class="col-4"><input name="location" class="form-control" placeholder="ตำแหน่ง" /></div>
                <div class="col-3"><button class="btn btn-teal w-100">เพิ่ม</button></div>
            </form>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                    @foreach (var g in gates)
                    {
                        <tr>
                            <td colspan="4" class="border-0 pb-0">
                                <form asp-action="EditGate" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <div class="col-4"><input name="name" class="form-control form-control-sm" value="@g.Name" /></div>
                                    <div class="col-4"><input name="location" class="form-control form-control-sm" value="@g.Location" /></div>
                                    <div class="col-2 small">@(g.IsActive ? "ใช้งาน" : "ปิด")</div>
                                    <div class="col-2 text-end">
                                        <button class="btn btn-sm btn-outline-primary" type="submit">บันทึก</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end pt-0">
                                <form asp-action="Toggle" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="gate" />
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">สลับสถานะ</button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('ลบจุดเข้า-ออก @g.Name ใช่หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="gate" />
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">ลบ</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card vm-card p-3 mb-3">
            <h2 class="h5">ประเภทผู้มาติดต่อ</h2>
            <form asp-action="AddType" method="post" class="row g-2 mb-3">
                @Html.AntiForgeryToken()
                <div class="col-4"><input name="name" class="form-control" placeholder="ชื่อ" /></div>
                <div class="col-3"><input name="badgeLabel" class="form-control" placeholder="GUEST" /></div>
                <div class="col-2"><input name="color" class="form-control" type="color" value="#1a56a0" /></div>
                <div class="col-3"><button class="btn btn-teal w-100">เพิ่ม</button></div>
            </form>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                    @foreach (var t in types)
                    {
                        <tr>
                            <td colspan="4" class="border-0 pb-0">
                                <form asp-action="EditType" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <div class="col-4"><input name="name" class="form-control form-control-sm" value="@t.Name" /></div>
                                    <div class="col-3"><input name="badgeLabel" class="form-control form-control-sm" value="@t.BadgeLabel" /></div>
                                    <div class="col-2"><input name="color" class="form-control form-control-sm form-control-color" type="color" value="@t.Color" /></div>
                                    <div class="col-3 text-end text-nowrap">
                                        <span class="small me-1">@(t.IsActive ? "ใช้งาน" : "ปิด")</span>
                                        <button class="btn btn-sm btn-outline-primary" type="submit">บันทึก</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end pt-0">
                                <form asp-action="Toggle" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="type" />
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">สลับสถานะ</button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('ลบประเภท @t.Name ใช่หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="type" />
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">ลบ</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card vm-card p-3">
            <h2 class="h5">วัตถุประสงค์</h2>
            <form asp-action="AddPurpose" method="post" class="row g-2 mb-3">
                @Html.AntiForgeryToken()
                <div class="col-9"><input name="name" class="form-control" placeholder="วัตถุประสงค์" /></div>
                <div class="col-3"><button class="btn btn-teal w-100">เพิ่ม</button></div>
            </form>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                    @foreach (var p in purposes)
                    {
                        <tr>
                            <td colspan="3" class="border-0 pb-0">
                                <form asp-action="EditPurpose" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <div class="col-7"><input name="name" class="form-control form-control-sm" value="@p.Name" /></div>
                                    <div class="col-2 small">@(p.IsActive ? "ใช้งาน" : "ปิด")</div>
                                    <div class="col-3 text-end">
                                        <button class="btn btn-sm btn-outline-primary" type="submit">บันทึก</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end pt-0">
                                <form asp-action="Toggle" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="purpose" />
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">สลับสถานะ</button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('ลบวัตถุประสงค์ @p.Name ใช่หรือไม่?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="purpose" />
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">ลบ</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
