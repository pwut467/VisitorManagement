@model IEnumerable<Visit>
@{
    ViewData["Title"] = "รายงานผู้มาติดต่อ";
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
    var types = (IEnumerable<VisitorType>)ViewBag.Types;
    var seq = 0;
}

<div class="card vm-card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">จาก</label>
            <input type="date" name="from" class="form-control" value="@from.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">ถึง</label>
            <input type="date" name="to" class="form-control" value="@to.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">ประเภท</label>
            <select name="visitorTypeId" class="form-select">
                <option value="">ทั้งหมด</option>
                @foreach (var t in types)
                {
                    <option value="@t.Id" selected="@(ViewBag.VisitorTypeId as int? == t.Id)">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-teal">กรอง</button>
            <a class="btn btn-outline-secondary" asp-action="Excel" asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")" asp-route-visitorTypeId="@ViewBag.VisitorTypeId">Excel</a>
        </div>
    </form>
</div>

<div class="card vm-card p-3">
    <p class="text-muted">ทั้งหมด @Model.Count() รายการ · เข้าแล้ว @Model.Count(v => v.CheckInAt != null) · ออกแล้ว @Model.Count(v => v.CheckOutAt != null)</p>
    <table id="report-table" class="table table-striped table-hover align-middle w-100">
        <thead>
        <tr>
            <th class="col-seq text-center">ลำดับ</th>
            <th>รหัส</th>
            <th>ชื่อผู้มาติดต่อ</th>
            <th>ทะเบียนรถ</th>
            <th>ประเภท</th>
            <th>มาหา</th>
            <th>เข้า</th>
            <th>ออก</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var v in Model)
        {
            var stripe = (++seq % 2 == 1) ? "row-odd" : "row-even";
            <tr class="@stripe">
                <td class="col-seq text-center">@seq</td>
                <td class="text-nowrap">@v.VisitNumber</td>
                <td>@v.GuestFullName</td>
                <td class="text-nowrap">@(string.IsNullOrWhiteSpace(v.VehiclePlate) ? "—" : v.VehiclePlate)</td>
                <td>@v.VisitorType.Name</td>
                <td>@v.HostEmployee.FullName</td>
                <td class="text-nowrap">@(v.CheckInAt?.ToString("dd/MM HH:mm") ?? "—")</td>
                <td class="text-nowrap">@(v.CheckOutAt?.ToString("dd/MM HH:mm") ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
